# Server
LOG_LEVEL=INFO
APP_HOST=localhost:3000

# Authentication
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRY=7m
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_MAX_AGE_SECONDS=604800
AUTH_EXCLUDE_PATHS=/health,/auth/api/v1/token-refresh,/student/api/v1/login,/student/api/v1/register,/student/api/v1/email,/student/api/v1/password-reset,/student/api/v1/verify-email

# CORS
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Request-ID
CORS_CREDENTIALS=false

# GET cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=420
CACHE_EXCLUDE_PATHS=/health

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_EXCLUDE_PATHS=/health
RATELIMIT_ROUTES='[{"prefix": "/student/api", "window_ms": 90000, "strategy": "fixed_window"}, {"prefix": "*", "window_ms": 90000, "strategy": "fixed_window"}]'

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Database
AUTO_CREATE_TABLES=false
# Optional PostgreSQL override; defaults to localhost/coursewave_db
# DATABASE_URL=postgresql+asyncpg://postgres:user123@localhost:5432/coursewave_db

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
