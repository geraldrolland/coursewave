# Server
PROXY_SECRET=change-me-in-production
PROXY_SIGNATURE_TTL_SECONDS=30
LOG_LEVEL=INFO
APP_HOST=localhost:3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Database
AUTO_CREATE_TABLES=false
